{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": "money-scribe-code.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "headerText": "Money Scribe — offline-first personal finance tracker built with Flutter.",
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100
    }
  },
  "include": [
    ".devcontainer/**",
    ".github/**",
    ".husky/**",
    ".vscode/**",
    "scripts/**",
    "docs/**",
    "lib/**",
    "test/**",
    ".cspell/**",
    ".editorconfig",
    ".env.example",
    ".gitattributes",
    ".gitignore",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "analysis_options.yaml",
    "commitlint.config.mjs",
    "cspell.json",
    "docker-compose.yml",
    "package.json",
    "pnpm-workspace.yaml",
    "pubspec.yaml"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      "money-scribe-code.xml",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.svg",
      "*.ico",
      "node_modules/**",
      ".git/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
