# ── .env.example ──────────────────────────────────────────────────────────────
# Names of the build-time values Money Scribe reads, without their values.
#
# One file per environment, next to this one: .env.staging and .env.production.
# Copy the names below into each and fill in the value of that environment. Both
# files are ignored by Git and must never be committed. Server secrets never
# belong in the app: whatever is built in can be read from it.
#
# Values are passed at build time, never bundled as an asset:
#   flutter run --flavor staging --dart-define-from-file=.env.staging
# and read in Dart as compile-time constants:
#   const value = String.fromEnvironment('NAME');
#
# In CI the signed Android build writes the file from the variables of its
# GitHub environment (docs/environments.md), so nothing private is committed.
# ─────────────────────────────────────────────────────────────────────────────

# The server's address: https, no path, no trailing slash, for example
# https://api.example.com. The paths of the API start with /api/v1. Leave the
# value empty for a build with no server: the app keeps its fake data.
API_BASE_URL=

# The public site key of the Cloudflare Turnstile widget of this environment,
# for the bot check the server asks for after repeated failed sign-ins. It is
# public once the app is built, but it is kept out of Git like the address. The
# secret key of Turnstile belongs to the server alone: never put it here. Leave
# the value empty for a build without the check: the sign-in then says to try
# again later.
TURNSTILE_SITE_KEY=
