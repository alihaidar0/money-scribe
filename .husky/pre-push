# ── Block pushes to main and develop ──────────────────────────────────────────
# A local convenience; the GitHub rulesets are the real gate. A branch is only
# blocked once it exists on the remote, so creating it (the first push when a
# project is set up) still works.
remote_name="${1:-origin}"
pushing_commits=0
pushed_files=""
pushed_unknown=0
while read -r _ local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  if { [ "$branch" = "main" ] || [ "$branch" = "develop" ]; } \
    && git show-ref --verify --quiet "refs/remotes/${remote_name}/${branch}"; then
    echo ""
    echo "✖ Direct push to '${branch}' is blocked."
    echo "  Push to a topic branch, then open a pull request into develop"
    echo "  (a release is a pull request from develop into main)."
    echo ""
    exit 1
  fi
  # Anything but all zeros is a real commit (a branch deletion pushes zeros).
  case "$local_sha" in
    *[!0]*)
      pushing_commits=1
      # What these commits change: from the remote's tip, or for a new branch
      # from where it left develop. When that cannot be told, assume the worst.
      case "$remote_sha" in
        *[!0]*) base="$remote_sha" ;;
        *) base="$(git merge-base "refs/remotes/${remote_name}/develop" "$local_sha" 2>/dev/null || true)" ;;
      esac
      if [ -n "$base" ] && range_files="$(git diff --name-only --no-renames "$base" "$local_sha" 2>/dev/null)"; then
        pushed_files="${pushed_files}
${range_files}"
      else
        pushed_unknown=1
      fi
      ;;
  esac
done

# ── Static analysis before commits leave the machine ──────────────────────────
# Skipped without a Flutter project (no pubspec.yaml), when only deleting branches,
# when the pushed commits change nothing the analysis reads (documentation,
# workflows, scripts: scripts/dart-affecting.sh), and outside the dev container
# (Flutter lives there; CI runs the analysis too).
# --fatal-infos matches the CI analyze job, so info-level lints fail here first.
in_container=0
if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ]; then
  in_container=1
fi
needs_analysis=0
if [ "$pushed_unknown" = 1 ] || printf '%s\n' "$pushed_files" | bash scripts/dart-affecting.sh 2>/dev/null; then
  needs_analysis=1
fi
if [ "$in_container" = 1 ] && [ "$pushing_commits" = 1 ] && [ -f "pubspec.yaml" ] && [ "$needs_analysis" = 1 ]; then
  echo "Running flutter analyze --fatal-infos before push..."
  flutter analyze --fatal-infos || {
    echo ""
    echo "✖ flutter analyze --fatal-infos reported issues — fix them before pushing."
    exit 1
  }
fi

exit 0
