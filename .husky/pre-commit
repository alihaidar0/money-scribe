# The toolchain (Node, pnpm, Flutter) lives in the dev container. When git runs
# on the host (terminal or GUI) this hook is skipped; CI runs the same check.
if [ ! -f /.dockerenv ] && [ ! -f /run/.containerenv ] && [ -z "${REMOTE_CONTAINERS:-}" ] && [ -z "${CODESPACES:-}" ]; then
  echo "ℹ️  Not inside the dev container — format check skipped (CI still enforces it)"
  exit 0
fi

# Skip all checks if Flutter has not been initialised yet.
# Run `flutter create .` first, then `flutter pub get` to activate these hooks.
if [ ! -f "pubspec.yaml" ]; then
  echo "ℹ️  No pubspec.yaml found — pre-commit checks skipped (run flutter create . first)"
  exit 0
fi

# ── Dart format check (staged files only) ─────────────────────────────────────
# Kept light on purpose: only the Dart files in this commit are checked, so the
# hook stays fast on large projects. Full analysis runs before every push and
# in CI. Fix with: dart format <file>   (or: dart format .)
if ! git diff --cached --name-only -z --diff-filter=ACMR -- '*.dart' \
  | xargs -0 --no-run-if-empty dart format --set-exit-if-changed; then
  echo ""
  echo "✖ Some staged Dart files are not formatted. Run: dart format ."
  exit 1
fi
