{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs in the container before every Android launch configuration, so
      // pressing F5 connects to the host emulator even if it was started after
      // the container (waits up to 30 s while the emulator boots).
      "label": "Connect host emulator",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/connect-emulator.sh", "--wait", "30"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      // Terminal > Run Task > "Run app on emulator": connects the container to
      // the host emulator, then runs the staging flavor in an interactive
      // terminal (r hot reload, R hot restart, q quit).
      "label": "Run app on emulator",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "scripts/connect-emulator.sh --wait 30 && flutter run --flavor staging -d host.docker.internal:5555"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
